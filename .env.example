# Copy to .env and fill in. .env is gitignored -- never commit real values.
# Every variable below is read by pipeline/ or api/; defaults shown are
# what the code falls back to when the variable is unset.

# --- Required ---------------------------------------------------------
# https://aistudio.google.com/apikey  (the API refuses to boot without it)
GEMINI_API_KEY=
# Fine-grained token with public-repo read access; unauthenticated
# GitHub calls are limited to 60/hour, which the hourly DAG will exhaust.
GITHUB_TOKEN=
# Password for the `api_trigger` Airflow user the API uses to trigger DAGs.
AIRFLOW_API_PASSWORD=

# --- Pipeline ---------------------------------------------------------
GITHUB_REPO=langchain-ai/langchain   # default repo; always included in the hourly refresh
GEMINI_MODEL=gemini-3.5-flash
GEMINI_RPM_LIMIT=5                   # judge-call pacing for evals (free tier)
AGENT_TIMEOUT_SECONDS=45             # hard bound on one /ask request
CACHE_TTL_SECONDS=1800               # in-process response cache TTL

# --- Local (non-docker) runs only --------------------------------------
# docker-compose sets these itself; they matter when you run
# `python -m pipeline...` or uvicorn directly on your machine.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_pipeline
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_pass
CHROMA_HOST=localhost
CHROMA_PORT=8001
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_API_USERNAME=api_trigger
