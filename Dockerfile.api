FROM python:3.11-slim

WORKDIR /app

# The API only needs pipeline's embedding/agent code, not the full stack --
# it never touches Postgres or Airflow at all (only the ingestion pipeline
# does). Trim apache-airflow out of the install: it's a huge dependency
# tree we don't need here, and would drag in the same Airflow-vs-modern-
# LLM-stack conflicts we hit before.
COPY requirements.txt /requirements.txt
RUN grep -v '^apache-airflow' /requirements.txt > /api_requirements.txt

# sentence-transformers depends on torch, and pip defaults to the full
# CUDA/GPU build -- hundreds of MB to several GB of NVIDIA libraries we
# never use (CPU-only embeddings here, no GPU on Cloud Run/Koyeb free
# tiers either). Installing the CPU-only wheel first means the later
# install of everything else finds torch already satisfied and skips
# the GPU build entirely.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir -r /api_requirements.txt

# Pre-download the sentence-transformers embedding model at BUILD time,
# not on first request -- avoids a slow, unpredictable cold start (and a
# surprise outbound call to Hugging Face) the first time someone hits the
# API after a deploy.
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"

COPY pipeline/ /app/pipeline/
COPY api/ /app/api/
COPY static/ /app/static/

# Baked-in snapshot of the vector store, built at image-build time from
# whatever's in ./chroma_data on the host. Cloud Run/Koyeb containers
# don't have a writable persistent disk between deploys, so for this
# project's scope we ship a point-in-time snapshot rather than wiring up
# a managed/persistent vector store -- the deployed agent's knowledge is
# as fresh as the last image build, not live-updating between ingestion
# runs. Worth stating plainly, not hiding.
COPY chroma_data/ /app/chroma_data/

ENV CHROMA_PERSIST_DIR=/app/chroma_data
ENV PYTHONPATH=/app

EXPOSE 8080

# Cloud Run/Koyeb inject $PORT and expect the container to listen on it;
# defaulting to 8080 for local/other environments.
CMD exec uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8080}